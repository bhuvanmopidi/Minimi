# Required
ANTHROPIC_API_KEY=        # https://console.anthropic.com/
TAVILY_API_KEY=           # https://app.tavily.com/ (web search; free tier is enough)

# Optional
MAIN_MODEL=claude-sonnet-5-5   # answers + tool use
FAST_MODEL=claude-haiku-5-5    # planner, claim extraction, summaries
DATABASE_PATH=./data/minimi.db
MOCK_NOW=                      # ISO timestamp to freeze "now", e.g. 2026-11-11T10:00:00Z (testing)
